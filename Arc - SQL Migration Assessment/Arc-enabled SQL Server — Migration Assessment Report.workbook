                },
                "leftContent": {
                  "columnMatch": "Value",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "greenRed"
                  },
                  "numberFormat": {
                    "unit": 17,
                    "options": {
                      "style": "decimal",
                      "maximumFractionDigits": 0
                    }
                  }
                },
                "showBorder": true,
                "size": "auto"
              }
            },
            "customWidth": "50",
            "name": "ov-card-targets"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ 'microsoft.azurearcdata/sqlserverinstances'\n| where 'value::all' in ({ResourceGroup}) or '*' in ({ResourceGroup}) or resourceGroup in~ ({ResourceGroup})\n| where '{TagName}' == '' or tostring(tags['{TagName}']) =~ '{TagValue}'\n| extend s = properties.migration.assessment.settings\n| where isnotnull(s)\n| summarize Instances = count()\n    by Lookback        = tostring(s.lookbackPeriodInDays),\n       Percentile      = tostring(s.percentile),\n       DiscountPct     = tostring(s.discountPercentage),\n       TargetLocation  = tostring(s.targetLocation),\n       Strategy        = tostring(s.strategy),\n       SqlLicense      = tostring(s.costOptions.sqlLicenseCostOption),\n       WindowsLicense  = tostring(s.costOptions.windowsLicenseCostOption)\n| order by Instances desc",
              "size": 0,
              "showAnalytics": true,
              "title": "Assessment cost options & strategy (SQL/Windows license model, discount %, target location — drives every cost number on every tab)",
              "showExportToExcel": true,
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscriptions}"
              ],
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Instances",
                    "formatter": 8,
                    "formatOptions": {
                      "min": 0,
                      "palette": "blue"
                    }
                  }
                ],
                "filter": true
              }
            },
            "customWidth": "100",
            "name": "ov-card-config"
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "overview"
      },
      "name": "group-overview"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "### Inventory\n\nSQL instances, Arc hosts, and SQL extensions. Missing host or extension data can indicate limited permissions or incomplete inventory, not necessarily an absent installation. Inventory timestamps and assessment timestamps describe separate uploads."
            },
            "name": "inv-title"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ 'microsoft.azurearcdata/sqlserverinstances'\n| where 'value::all' in ({ResourceGroup}) or '*' in ({ResourceGroup}) or resourceGroup in~ ({ResourceGroup})\n| where '{TagName}' == '' or tostring(tags['{TagName}']) =~ '{TagValue}'\n| extend p = properties\n| project\n    SQLArcResourceName = name,\n    ResourceGroup      = resourceGroup,\n    SubscriptionId     = subscriptionId,\n    Location           = location,\n    ResourceId         = id,\n    SQLInstanceName    = tostring(coalesce(p.instanceName, p.sqlInstanceName, name)),\n    SQLVersion         = tostring(coalesce(p.version, p.sqlVersion)),\n    SQLProductVersion  = coalesce(tostring(p.currentVersion), 'Unknown'),\n    SQLEdition         = tostring(p.edition),\n    SQLCoreCount       = coalesce(toint(p.cores), toint(p.vCore), toint(p.coreCount)),\n    HostMachineId      = tolower(tostring(p.containerResourceId)),\n    LastInventoryUpload = todatetime(p.lastInventoryUploadTime)\n| join kind=leftouter (\n    resources\n    | where type =~ 'microsoft.hybridcompute/machines'\n    | extend mp = properties\n    | project\n        HostMachineId    = tolower(id),\n        HostMachineName  = name,\n        HostOSName       = tostring(mp.osName),\n        HostOSVersion    = tostring(mp.osVersion),\n        HostOSSku        = tostring(mp.osSku),\n        HostLastSeen     = todatetime(mp.lastStatusChange),\n        AgentVersion     = tostring(mp.agentVersion),\n        AgentStatus      = tostring(mp.status)\n) on HostMachineId\n| join kind=leftouter (\n    resources\n    | where type =~ 'microsoft.hybridcompute/machines/extensions'\n    | where tolower(tostring(properties.publisher)) == 'microsoft.azuredata'\n    | where tostring(properties.type) in~ ('WindowsAgent.SqlServer','LinuxAgent.SqlServer')\n    | extend HostMachineId = tolower(substring(id, 0, indexof(tolower(id), '/extensions/')))\n    | summarize take_any(*) by HostMachineId\n    | project HostMachineId, ArcSqlExtInstalled = 'Yes', ArcSqlExtVersion = tostring(properties.typeHandlerVersion), ArcSqlExtState = tostring(properties.provisioningState)\n) on HostMachineId\n| extend ArcSqlExtInstalled = coalesce(ArcSqlExtInstalled, 'No')\n| project-away HostMachineId1, HostMachineId2\n| order by SubscriptionId asc, ResourceGroup asc, SQLArcResourceName asc",
              "size": 0,
              "showAnalytics": true,
              "exportFieldName": "ResourceId",
              "exportParameterName": "InstanceFilter",
              "showExportToExcel": true,
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscriptions}"
              ],
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "LastInventoryUpload",
                    "formatter": 6
                  },
                  {
                    "columnMatch": "HostLastSeen",
                    "formatter": 6
                  },
                  {
                    "columnMatch": "AgentStatus",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        {
                          "operator": "==",
                          "thresholdValue": "Connected",
                          "representation": "green",
                          "text": "{0}"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "Disconnected",
                          "representation": "red",
                          "text": "{0}"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "gray",
                          "text": "{0}"
                        }
                      ]
                    }
                  },
                  {
                    "columnMatch": "ArcSqlExtInstalled",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "icons",
                      "thresholdsGrid": [
                        {
                          "operator": "==",
                          "thresholdValue": "Yes",
                          "representation": "success",
                          "text": "Yes"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "critical",
                          "text": "No"
                        }
                      ]
                    }
                  },
                  {
                    "columnMatch": "ArcSqlExtVersion",
                    "formatter": 1
                  },
                  {
                    "columnMatch": "ArcSqlExtState",
                    "formatter": 1
                  },
                  {
                    "columnMatch": "HostMachineId",
                    "formatter": 5
                  },
                  {
                    "columnMatch": "ResourceId",
                    "formatter": 7,
                    "formatOptions": {
                      "linkTarget": "Resource",
                      "linkLabel": "Open"
                    }
                  },
                  {
                    "columnMatch": "SubscriptionId",
                    "formatter": 5
                  }
                ],
                "filter": true,
                "sortBy": [
                  {
                    "itemKey": "SQLArcResourceName",
                    "sortOrder": 1
                  }
                ]
              },
              "sortBy": [
                {
                  "itemKey": "SQLArcResourceName",
                  "sortOrder": 1
                }
              ]
            },
            "name": "inv-grid"
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "inventory"
      },
      "name": "group-inventory"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "### Migration Target Recommendations\n\nAssessment-reported readiness, target SKUs, and cost components. The workbook-selected preferred target is the least-cost Ready, priced PaaS target for `MigrateToPaaS`, or a Ready, priced VM for `MigrateToIaaS`. Disabled assessments, unknown currencies, and unrecognized strategies have no preferred selection. This is a local comparison rule, not a replacement for the assessment engine's recommendation.\n\nBlocker counts and license-cost fields are displayed as reported; missing values are not zero or proof of license entitlement. [Compatibility findings and remediation](https://learn.microsoft.com/en-us/sql/sql-server/azure-arc/migration-assessment#compatibility) are available in the Arc resource's Migration > Assessments report, subject to telemetry permissions.",
              "style": "info"
            },
            "name": "rec-title"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "p-target",
                  "version": "KqlParameterItem/1.0",
                  "name": "TargetFilter",
                  "label": "Target",
                  "type": 2,
                  "isRequired": true,
                  "multiSelect": true,
                  "quote": "'",
                  "delimiter": ",",
                  "jsonData": "[{\"value\":\"Azure SQL MI\",\"label\":\"Azure SQL MI\",\"selected\":true},{\"value\":\"Azure SQL DB\",\"label\":\"Azure SQL DB\",\"selected\":true},{\"value\":\"SQL Server on Azure VM\",\"label\":\"SQL Server on Azure VM\",\"selected\":true}]",
                  "value": [
                    "Azure SQL MI",
                    "Azure SQL DB",
                    "SQL Server on Azure VM"
                  ]
                },
                {
                  "id": "p-onlypref",
                  "version": "KqlParameterItem/1.0",
                  "name": "OnlyPreferred",
                  "label": "Show only preferred",
                  "type": 2,
                  "isRequired": true,
                  "jsonData": "[{\"value\":\"true\",\"label\":\"Yes\"},{\"value\":\"false\",\"label\":\"No\",\"selected\":true}]"
                }
              ],
              "style": "pills",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources"
            },
            "name": "rec-params"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ 'microsoft.azurearcdata/sqlserverinstances'\n| where 'value::all' in ({ResourceGroup}) or '*' in ({ResourceGroup}) or resourceGroup in~ ({ResourceGroup})\n| where '{TagName}' == '' or tostring(tags['{TagName}']) =~ '{TagValue}'\n| extend asmt = properties.migration.assessment\n| extend r = asmt.skuRecommendationResults, Strategy = tostring(asmt.settings.strategy), Currency = coalesce(tostring(asmt.settings.currency), 'Unknown')\n| where 'value::all' in ({CurrencyFilter}) or '*' in ({CurrencyFilter}) or Currency in ({CurrencyFilter})\n| extend MICost = todouble(r.azureSqlManagedInstance.monthlyCost.totalCost), DBCost = todouble(r.azureSqlDatabase.monthlyCost.totalCost), VMCost = todouble(r.azureSqlVirtualMachine.monthlyCost.totalCost)\n| extend MIReadyCost = iff(tobool(asmt.enabled) == true and tostring(r.azureSqlManagedInstance.recommendationStatus) =~ 'Ready' and MICost >= 0, MICost, real(null)), DBReadyCost = iff(tobool(asmt.enabled) == true and tostring(r.azureSqlDatabase.recommendationStatus) =~ 'Ready' and DBCost >= 0, DBCost, real(null)), VMReadyCost = iff(tobool(asmt.enabled) == true and tostring(r.azureSqlVirtualMachine.recommendationStatus) =~ 'Ready' and VMCost >= 0, VMCost, real(null))\n| extend PaaSCheapest = min_of(MIReadyCost, DBReadyCost)\n| extend PreferredTarget = case(Strategy =~ 'MigrateToIaaS' and isnotnull(VMReadyCost), 'SQL Server on Azure VM', Strategy =~ 'MigrateToPaaS' and isnotnull(PaaSCheapest) and MIReadyCost == PaaSCheapest, 'Azure SQL MI', Strategy =~ 'MigrateToPaaS' and isnotnull(PaaSCheapest), 'Azure SQL DB', '')\n| extend SelectedTotal = case(PreferredTarget == 'SQL Server on Azure VM', VMReadyCost, PreferredTarget == 'Azure SQL MI', MIReadyCost, PreferredTarget == 'Azure SQL DB', DBReadyCost, real(null)), BaselineReady = max_of(MIReadyCost, DBReadyCost, VMReadyCost)\n| extend ComparisonStatus = case(Currency == 'Unknown', 'Unknown currency', isnull(tobool(asmt.enabled)), 'Assessment state unknown', tobool(asmt.enabled) != true, 'Assessment disabled', Strategy !in~ ('MigrateToIaaS','MigrateToPaaS'), 'Unrecognized strategy', isnull(SelectedTotal), 'No Ready priced target for strategy', 'Comparable')\n| extend MonthlyDifference = iff(ComparisonStatus == 'Comparable', BaselineReady - SelectedTotal, real(null))\n| extend impacted = asmt.impactedObjectsSummary\n| project name, id, resourceGroup, subscriptionId, Currency, Strategy, PreferredTarget, ComparisonStatus, AssessmentEnabled = case(isnull(tobool(asmt.enabled)), 'Unknown', tobool(asmt.enabled) == true, 'Yes', 'No'), Targets = pack_array(pack('Target','Azure SQL MI','Data',r.azureSqlManagedInstance,'ImpactedObjectCount',toint(array_length(impacted.azureSqlManagedInstance))), pack('Target','Azure SQL DB','Data',r.azureSqlDatabase,'ImpactedObjectCount',toint(array_length(impacted.azureSqlDatabase))), pack('Target','SQL Server on Azure VM','Data',r.azureSqlVirtualMachine,'ImpactedObjectCount',toint(array_length(impacted.azureSqlVirtualMachine))))\n| mv-expand Targets\n| extend Target = tostring(Targets.Target), Data = Targets.Data, ImpactedObjectCount = toint(Targets.ImpactedObjectCount)\n| extend sku = Data.targetSku, RecommendationStatus = coalesce(tostring(Data.recommendationStatus), 'Unknown')\n| extend IsPreferredByStrategy = ComparisonStatus == 'Comparable' and Target == PreferredTarget, ServerBlockers = toint(Data.numberOfServerBlockerIssues)\n| extend Notes = case(IsPreferredByStrategy, 'Selected by workbook strategy and Ready price; confirm database compatibility in the Arc assessment report.', ComparisonStatus != 'Comparable', ComparisonStatus, RecommendationStatus =~ 'NotReady', 'Review compatibility findings in the Arc resource: Migration > Assessments.', RecommendationStatus =~ 'Ready', 'Ready alternative; not the workbook-selected target.', 'Readiness unknown; inspect assessment health.')\n| where Target in ({TargetFilter})\n| where '{OnlyPreferred}' == 'false' or IsPreferredByStrategy == true\n| extend Preferred = iff(IsPreferredByStrategy, 'Yes', '')\n| extend dataDisks = sku.dataDiskSizes, logDisks = sku.logDiskSizes, tempDbDisks = sku.tempDbDiskSizes, vmSize = sku.virtualMachineSize\n| extend dataDiskCount = array_length(dataDisks), logDiskCount = array_length(logDisks), tempDbDiskCount = array_length(tempDbDisks)\n| extend DataDisk = case(isnull(dataDiskCount), 'Unknown', dataDiskCount == 0, 'None reported', strcat(iff(dataDiskCount == 1, '1 disk: ', strcat(dataDiskCount, ' disks; first: ')), coalesce(tostring(dataDisks[0].size), 'Unknown SKU'), ', ', coalesce(tostring(dataDisks[0].maxSizeInGib), 'Unknown'), ' GiB, ', coalesce(tostring(dataDisks[0].maxIops), 'Unknown'), ' IOPS, ', coalesce(tostring(dataDisks[0].maxThroughputInMbps), 'Unknown'), ' MB/s, cache=', coalesce(tostring(dataDisks[0].caching), 'Unknown')))\n| extend LogDisk = case(isnull(logDiskCount), 'Unknown', logDiskCount == 0, 'None reported', strcat(iff(logDiskCount == 1, '1 disk: ', strcat(logDiskCount, ' disks; first: ')), coalesce(tostring(logDisks[0].size), 'Unknown SKU'), ', ', coalesce(tostring(logDisks[0].maxSizeInGib), 'Unknown'), ' GiB, ', coalesce(tostring(logDisks[0].maxIops), 'Unknown'), ' IOPS, ', coalesce(tostring(logDisks[0].maxThroughputInMbps), 'Unknown'), ' MB/s, cache=', coalesce(tostring(logDisks[0].caching), 'Unknown')))\n| extend TempDbDisk = case(isnull(tempDbDiskCount), 'Unknown', tempDbDiskCount == 0, 'None reported', strcat(iff(tempDbDiskCount == 1, '1 disk: ', strcat(tempDbDiskCount, ' disks; first: ')), coalesce(tostring(tempDbDisks[0].size), 'Unknown SKU'), ', ', coalesce(tostring(tempDbDisks[0].maxSizeInGib), 'Unknown'), ' GiB, ', coalesce(tostring(tempDbDisks[0].maxIops), 'Unknown'), ' IOPS, ', coalesce(tostring(tempDbDisks[0].maxThroughputInMbps), 'Unknown'), ' MB/s, cache=', coalesce(tostring(tempDbDisks[0].caching), 'Unknown')))\n| project Preferred, SQLArcResourceName = name, Target, Readiness = RecommendationStatus, AssessmentEnabled, ServerBlockers, Notes, MonthlyCost = todouble(Data.monthlyCost.totalCost), ComputeCost = todouble(Data.monthlyCost.computeCost), StorageCost = todouble(Data.monthlyCost.storageCost), IOPSCost = todouble(Data.monthlyCost.iopsCost), SQLLicenseCost = todouble(Data.monthlyCost.sqlLicenseCost), WindowsLicenseCost = todouble(Data.monthlyCost.windowsLicenseCost), Currency, Strategy, PurchasingModel = tostring(sku.category.sqlPurchasingModel), SkuServiceTier = tostring(sku.category.sqlServiceTier), SkuHardware = tostring(sku.category.hardwareType), SkuComputeTier = tostring(sku.category.computeTier), SkuComputeSize = toint(sku.computeSize), ZoneRedundant = tobool(sku.category.zoneRedundancyAvailable), SkuStorageMaxSizeMB = todouble(sku.storageMaxSizeInMb), SkuMaxStorageIops = todouble(sku.maxStorageIops), SkuMaxThroughputMBps = todouble(sku.maxThroughputMBps), PredictedDataMB = todouble(sku.predictedDataSizeInMb), PredictedLogMB = todouble(sku.predictedLogSizeInMb), VmAzureSku = tostring(vmSize.azureSkuName), VmFamily = tostring(vmSize.virtualMachineFamily), VmVCPUs = toint(vmSize.vCPUsAvailable), VmAltSkus = iff(isnotnull(sku.category.availableVmSkus), strcat_array(sku.category.availableVmSkus, ', '), ''), DataDisk, LogDisk, TempDbDisk, ImpactedObjectCount, ResourceId = id, ResourceGroup = resourceGroup, SubscriptionId = subscriptionId\n| order by SQLArcResourceName asc, Preferred desc, MonthlyCost asc",
              "size": 0,
              "showAnalytics": true,
              "showExportToExcel": true,
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscriptions}"
              ],
              "visualization": "table",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Preferred",
                    "formatter": 1,
                    "formatOptions": {
                      "customColumnWidthSetting": "40px"
                    }
                  },
                  {
                    "columnMatch": "Readiness",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        {
                          "operator": "==",
                          "thresholdValue": "Ready",
                          "representation": "green",
                          "text": "{0}"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "NotReady",
                          "representation": "red",
                          "text": "{0}"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "gray",
                          "text": "{0}"
                        }
                      ]
                    }
                  },
                  {
                    "columnMatch": "AssessmentEnabled",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "icons",
                      "thresholdsGrid": [
                        {
                          "operator": "==",
                          "thresholdValue": "Yes",
                          "representation": "success",
                          "text": "Yes"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "No",
                          "representation": "critical",
                          "text": "No"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "warning",
                          "text": "Unknown"
                        }
                      ]
                    }
                  },
                  {
                    "columnMatch": "Notes",
                    "formatter": 1
                  },
                  {
                    "columnMatch": "MonthlyCost",
                    "formatter": 8,
                    "formatOptions": {
                      "min": 0,
                      "palette": "blue"
                    },
                    "numberFormat": {
                      "unit": 0,
                      "options": {
                        "style": "decimal",
                        "minimumFractionDigits": 2,
                        "maximumFractionDigits": 2
                      }
                    }
                  },
                  {
                    "columnMatch": "ComputeCost",
                    "formatter": 0,
                    "numberFormat": {
                      "unit": 0,
                      "options": {
                        "style": "decimal",
                        "maximumFractionDigits": 2
                      }
                    }
                  },
                  {
                    "columnMatch": "StorageCost",
                    "formatter": 0,
                    "numberFormat": {
                      "unit": 0,
                      "options": {
                        "style": "decimal",
                        "maximumFractionDigits": 2
                      }
                    }
                  },
                  {
                    "columnMatch": "IOPSCost",
                    "formatter": 0,
                    "numberFormat": {
                      "unit": 0,
                      "options": {
                        "style": "decimal",
                        "maximumFractionDigits": 2
                      }
                    }
                  },
                  {
                    "columnMatch": "SQLLicenseCost",
                    "formatter": 0,
