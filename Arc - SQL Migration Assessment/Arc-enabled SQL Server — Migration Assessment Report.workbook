    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "### Databases\n\nDatabase inventory scoped through parent SQL instances and their tags. ServerMI, ServerDB, and ServerVM are parent-instance readiness states, not per-database compatibility results. Encryption is the reported database setting, not proof of migration readiness. Detailed findings are available in the [Arc assessment Compatibility report](https://learn.microsoft.com/en-us/sql/sql-server/azure-arc/migration-assessment#compatibility)."
            },
            "name": "db-title"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ 'microsoft.azurearcdata/sqlserverinstances/databases'\n| extend p = properties, parts = split(id, '/')\n| extend ParentId = tolower(strcat_array(array_slice(parts, 0, 8), '/'))\n| where '{InstanceFilter}' in ('', 'value::all') or ParentId =~ '{InstanceFilter}'\n| project DatabaseName = name, SQLArcResourceName = tostring(parts[8]), ParentId, ResourceGroup = resourceGroup, SubscriptionId = subscriptionId, Location = location, ResourceId = id, DatabaseState = tostring(p.state), SizeMB = todouble(p.sizeMB), SpaceAvailableMB = todouble(p.spaceAvailableMB), DataFileSizeMB = todouble(p.dataFileSizeMB), LogFileSizeMB = todouble(p.logFileSizeMB), RecoveryMode = tostring(p.recoveryMode), CompatibilityLevel = toint(p.compatibilityLevel), Collation = tostring(p.collationName), IsReadOnly = tobool(p.isReadOnly), IsEncrypted = tobool(p.databaseOptions.isEncrypted), CreatedDate = todatetime(p.databaseCreationDate), LastUpload = todatetime(p.lastDatabaseUploadTime)\n| join kind=inner (\n    resources\n    | where type =~ 'microsoft.azurearcdata/sqlserverinstances'\n    | where 'value::all' in ({ResourceGroup}) or '*' in ({ResourceGroup}) or resourceGroup in~ ({ResourceGroup})\n    | where '{TagName}' == '' or tostring(tags['{TagName}']) =~ '{TagValue}'\n    | extend asmt = properties.migration.assessment\n    | extend results = asmt.skuRecommendationResults\n    | project ParentId = tolower(id), ServerAssessment = case(isnull(tobool(asmt.enabled)), 'Unknown', tobool(asmt.enabled) == true, 'Enabled', 'Disabled'), ServerMI = coalesce(tostring(results.azureSqlManagedInstance.recommendationStatus), 'Unknown'), ServerDB = coalesce(tostring(results.azureSqlDatabase.recommendationStatus), 'Unknown'), ServerVM = coalesce(tostring(results.azureSqlVirtualMachine.recommendationStatus), 'Unknown'), ServerStrategy = tostring(asmt.settings.strategy)\n) on ParentId\n| project-away ParentId, ParentId1\n| order by SQLArcResourceName asc, DatabaseName asc",
              "size": 0,
              "showAnalytics": true,
              "showExportToExcel": true,
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscriptions}"
              ],
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "DatabaseState",
                    "formatter": 1
                  },
                  {
                    "columnMatch": "IsEncrypted",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "icons",
                      "thresholdsGrid": [
                        {
                          "operator": "==",
                          "thresholdValue": "true",
                          "representation": "success",
                          "text": ""
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "disabled",
                          "text": ""
                        }
                      ]
                    }
                  },
                  {
                    "columnMatch": "SizeMB",
                    "formatter": 8,
                    "formatOptions": {
                      "min": 0,
                      "palette": "blue"
                    },
                    "numberFormat": {
                      "unit": 0,
                      "options": {
                        "style": "decimal",
                        "maximumFractionDigits": 0
                      }
                    }
                  },
                  {
                    "columnMatch": "SpaceAvailableMB",
                    "formatter": 0,
                    "numberFormat": {
                      "unit": 0,
                      "options": {
                        "style": "decimal",
                        "maximumFractionDigits": 0
                      }
                    }
                  },
                  {
                    "columnMatch": "DataFileSizeMB",
                    "formatter": 0,
                    "numberFormat": {
                      "unit": 0,
                      "options": {
                        "style": "decimal",
                        "maximumFractionDigits": 0
                      }
                    }
                  },
                  {
                    "columnMatch": "LogFileSizeMB",
                    "formatter": 0,
                    "numberFormat": {
                      "unit": 0,
                      "options": {
                        "style": "decimal",
                        "maximumFractionDigits": 0
                      }
                    }
                  },
                  {
                    "columnMatch": "CreatedDate",
                    "formatter": 6
                  },
                  {
                    "columnMatch": "LastUpload",
                    "formatter": 6
                  },
                  {
                    "columnMatch": "ResourceId",
                    "formatter": 7,
                    "formatOptions": {
                      "linkTarget": "Resource",
                      "linkLabel": "Open"
                    }
                  },
                  {
                    "columnMatch": "SubscriptionId",
                    "formatter": 5
                  },
                  {
                    "columnMatch": "ServerAssessment",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        {
                          "operator": "==",
                          "thresholdValue": "Enabled",
                          "representation": "green",
                          "text": "{0}"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "gray",
                          "text": "{0}"
                        }
                      ]
                    }
                  },
                  {
                    "columnMatch": "ServerMI",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        {
                          "operator": "==",
                          "thresholdValue": "Ready",
                          "representation": "green",
                          "text": "{0}"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "NotReady",
                          "representation": "red",
                          "text": "{0}"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "gray",
                          "text": "{0}"
                        }
                      ]
                    }
                  },
                  {
                    "columnMatch": "ServerDB",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        {
                          "operator": "==",
                          "thresholdValue": "Ready",
                          "representation": "green",
                          "text": "{0}"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "NotReady",
                          "representation": "red",
                          "text": "{0}"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "gray",
                          "text": "{0}"
                        }
                      ]
                    }
                  },
                  {
                    "columnMatch": "ServerVM",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        {
                          "operator": "==",
                          "thresholdValue": "Ready",
                          "representation": "green",
                          "text": "{0}"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "NotReady",
                          "representation": "red",
                          "text": "{0}"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "gray",
                          "text": "{0}"
                        }
                      ]
                    }
                  }
                ],
                "filter": true,
                "sortBy": [
                  {
                    "itemKey": "$gen_heatmap_SizeMB_7",
                    "sortOrder": 2
                  }
                ]
              },
              "sortBy": [
                {
                  "itemKey": "$gen_heatmap_SizeMB_7",
                  "sortOrder": 2
                }
              ]
            },
            "name": "db-grid"
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "databases"
      },
      "name": "group-databases"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "### Pricing Options\n\nRetail assessment estimates for compute + storage + IOPS, excluding license costs. PAYG, one-year RI, and three-year RI correspond to the reported `WithNoOptionsSelected`, `With1YearRIAndProd`, and `With3YearRIAndProd` options.\n\nUnavailable means an option is absent, duplicated, incomplete, or contains negative costs. Explicit zero costs remain valid. Cheapest compares available options only; incomplete coverage is not a full market comparison. NotReady targets are retained for inspection, not recommended for purchase. Annual differences assume unchanged monthly prices and usage; customer-specific contractual pricing is not established here."
            },
            "name": "prc-title"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ 'microsoft.azurearcdata/sqlserverinstances'\n| where 'value::all' in ({ResourceGroup}) or '*' in ({ResourceGroup}) or resourceGroup in~ ({ResourceGroup})\n| where '{TagName}' == '' or tostring(tags['{TagName}']) =~ '{TagValue}'\n| extend asmt = properties.migration.assessment\n| where isnotnull(asmt) and isnotnull(asmt.skuRecommendationResults)\n| extend r = asmt.skuRecommendationResults, Currency = coalesce(tostring(asmt.settings.currency), 'Unknown')\n| where 'value::all' in ({CurrencyFilter}) or '*' in ({CurrencyFilter}) or Currency in ({CurrencyFilter})\n| extend Targets = pack_array(\n    pack('Target','Azure SQL MI', 'Data',r.azureSqlManagedInstance),\n    pack('Target','Azure SQL DB', 'Data',r.azureSqlDatabase),\n    pack('Target','SQL Server on Azure VM', 'Data',r.azureSqlVirtualMachine))\n| mv-expand Targets\n| extend Target = tostring(Targets.Target), Data = Targets.Data\n| extend Readiness = coalesce(tostring(Data.recommendationStatus), 'Unknown')\n| extend opts = iff(coalesce(array_length(Data.monthlyCostOptions), 0) == 0, dynamic([null]), Data.monthlyCostOptions)\n| mv-expand opt = opts\n| extend KeyName = tostring(opt.keyName), v = opt.keyValue\n| extend OptCompute = todouble(v.computeCost), OptStorage = todouble(v.storageCost), OptIops = todouble(v.iopsCost)\n| extend OptTotal = iff(OptCompute >= 0 and OptStorage >= 0 and OptIops >= 0, OptCompute + OptStorage + OptIops, real(null))\n| summarize\n    PAYG = sumif(OptTotal, KeyName =~ 'WithNoOptionsSelected'),\n    RI_1Yr = sumif(OptTotal, KeyName =~ 'With1YearRIAndProd'),\n    RI_3Yr = sumif(OptTotal, KeyName =~ 'With3YearRIAndProd'),\n    PAYGRows = countif(KeyName =~ 'WithNoOptionsSelected'),\n    RI1Rows = countif(KeyName =~ 'With1YearRIAndProd'),\n    RI3Rows = countif(KeyName =~ 'With3YearRIAndProd'),\n    PAYGValid = countif(KeyName =~ 'WithNoOptionsSelected' and isnotnull(OptTotal)),\n    RI1Valid = countif(KeyName =~ 'With1YearRIAndProd' and isnotnull(OptTotal)),\n    RI3Valid = countif(KeyName =~ 'With3YearRIAndProd' and isnotnull(OptTotal))\n    by ResourceId = id, SQLArcResourceName = name, ResourceGroup = resourceGroup, SubscriptionId = subscriptionId, Currency, Target, Readiness\n| extend PAYG = iff(PAYGRows == 1 and PAYGValid == 1, PAYG, real(null)), RI_1Yr = iff(RI1Rows == 1 and RI1Valid == 1, RI_1Yr, real(null)), RI_3Yr = iff(RI3Rows == 1 and RI3Valid == 1, RI_3Yr, real(null))\n| extend Lowest = min_of(PAYG, RI_1Yr, RI_3Yr)\n| extend Cheapest = case(isnull(Lowest), 'Unavailable', PAYG == Lowest, 'PAYG', RI_1Yr == Lowest, '1-yr RI', '3-yr RI')\n| extend PricingStatus = iff(isnotnull(PAYG) and isnotnull(RI_1Yr) and isnotnull(RI_3Yr), 'Complete', 'Incomplete or unavailable')\n| extend SavingsVsPAYG_3Yr_Pct = iff(PAYG > 0 and isnotnull(RI_3Yr), round(100.0 * (PAYG - RI_3Yr) / PAYG, 1), real(null))\n| extend AnnualSavings_3Yr = (PAYG - RI_3Yr) * 12\n| project Cheapest, PricingStatus, SQLArcResourceName, Target, Readiness, PAYG, RI_1Yr, RI_3Yr, SavingsVsPAYG_3Yr_Pct, AnnualSavings_3Yr, Currency, ResourceId, ResourceGroup, SubscriptionId\n| order by SQLArcResourceName asc, Target asc",
              "size": 0,
              "showAnalytics": true,
              "showExportToExcel": true,
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscriptions}"
              ],
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Cheapest",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        {
                          "operator": "==",
                          "thresholdValue": "3-yr RI",
                          "representation": "green",
                          "text": "{0}"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "1-yr RI",
                          "representation": "blue",
                          "text": "{0}"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "gray",
                          "text": "{0}"
                        }
                      ]
                    }
                  },
                  {
                    "columnMatch": "Readiness",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        {
                          "operator": "==",
                          "thresholdValue": "Ready",
                          "representation": "green",
                          "text": "{0}"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "NotReady",
                          "representation": "red",
                          "text": "{0}"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "gray",
                          "text": "{0}"
                        }
                      ]
                    }
                  },
                  {
                    "columnMatch": "PAYG",
                    "formatter": 8,
                    "formatOptions": {
                      "min": 0,
                      "palette": "redBright"
                    },
                    "numberFormat": {
                      "unit": 0,
                      "emptyValCustomText": "Unavailable",
                      "options": {
                        "style": "decimal",
                        "minimumFractionDigits": 2,
                        "maximumFractionDigits": 2
                      }
                    }
                  },
                  {
                    "columnMatch": "RI_1Yr",
                    "formatter": 8,
                    "formatOptions": {
                      "min": 0,
                      "palette": "blue"
                    },
                    "numberFormat": {
                      "unit": 0,
                      "emptyValCustomText": "Unavailable",
                      "options": {
                        "style": "decimal",
                        "minimumFractionDigits": 2,
                        "maximumFractionDigits": 2
                      }
                    }
                  },
                  {
                    "columnMatch": "RI_3Yr",
                    "formatter": 8,
                    "formatOptions": {
                      "min": 0,
                      "palette": "green"
                    },
                    "numberFormat": {
                      "unit": 0,
                      "emptyValCustomText": "Unavailable",
                      "options": {
                        "style": "decimal",
                        "minimumFractionDigits": 2,
                        "maximumFractionDigits": 2
                      }
                    }
                  },
                  {
                    "columnMatch": "SavingsVsPAYG_3Yr_Pct",
                    "formatter": 8,
                    "formatOptions": {
                      "min": 0,
                      "max": 100,
                      "palette": "greenRed"
                    },
                    "numberFormat": {
                      "unit": 1,
                      "emptyValCustomText": "Unavailable",
                      "options": {
                        "style": "decimal",
                        "maximumFractionDigits": 1
                      }
                    }
                  },
                  {
                    "columnMatch": "AnnualSavings_3Yr",
                    "formatter": 0,
                    "numberFormat": {
                      "unit": 0,
                      "emptyValCustomText": "Unavailable",
                      "options": {
                        "style": "decimal",
                        "maximumFractionDigits": 0
                      }
                    }
                  },
                  {
                    "columnMatch": "SubscriptionId",
                    "formatter": 5
                  },
                  {
                    "columnMatch": "ResourceGroup",
                    "formatter": 5
                  },
                  {
                    "columnMatch": "ResourceId",
                    "formatter": 7,
                    "formatOptions": {
                      "linkTarget": "Resource",
                      "linkLabel": "Open"
                    }
                  }
                ],
                "rowLimit": 2000,
                "filter": true
              },
              "sortBy": []
            },
            "name": "prc-grid"
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "pricing"
      },
      "name": "group-pricing"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "### Azure Target Cost Comparison\n\nMonthlyDifference is the most expensive Ready, priced target minus the workbook-selected preferred target, grouped by currency. This is an alternative Azure target comparison, not on-premises TCO, actual savings, or a business-case baseline. Annual and three-year differences assume unchanged prices and usage.\n\nSelection uses enabled assessments and known strategy values: `MigrateToPaaS` selects the cheapest Ready, priced MI or DB; `MigrateToIaaS` selects a Ready, priced VM. Unrecognized strategies and unknown currencies are excluded from totals and retained with a reason. Ties prefer MI. Stale results remain visible.\n\nAHB savings are unavailable without a matched license-included baseline. SQL edition alone does not establish license entitlement."
            },
            "name": "tco-title"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ 'microsoft.azurearcdata/sqlserverinstances'\n| where 'value::all' in ({ResourceGroup}) or '*' in ({ResourceGroup}) or resourceGroup in~ ({ResourceGroup})\n| where '{TagName}' == '' or tostring(tags['{TagName}']) =~ '{TagValue}'\n| extend asmt = properties.migration.assessment\n| extend r = asmt.skuRecommendationResults, Strategy = tostring(asmt.settings.strategy), Currency = coalesce(tostring(asmt.settings.currency), 'Unknown')\n| where 'value::all' in ({CurrencyFilter}) or '*' in ({CurrencyFilter}) or Currency in ({CurrencyFilter})\n| extend MICost = todouble(r.azureSqlManagedInstance.monthlyCost.totalCost), DBCost = todouble(r.azureSqlDatabase.monthlyCost.totalCost), VMCost = todouble(r.azureSqlVirtualMachine.monthlyCost.totalCost)\n| extend MIReadyCost = iff(tobool(asmt.enabled) == true and tostring(r.azureSqlManagedInstance.recommendationStatus) =~ 'Ready' and MICost >= 0, MICost, real(null)), DBReadyCost = iff(tobool(asmt.enabled) == true and tostring(r.azureSqlDatabase.recommendationStatus) =~ 'Ready' and DBCost >= 0, DBCost, real(null)), VMReadyCost = iff(tobool(asmt.enabled) == true and tostring(r.azureSqlVirtualMachine.recommendationStatus) =~ 'Ready' and VMCost >= 0, VMCost, real(null))\n| extend PaaSCheapest = min_of(MIReadyCost, DBReadyCost)\n| extend PreferredTarget = case(Strategy =~ 'MigrateToIaaS' and isnotnull(VMReadyCost), 'SQL Server on Azure VM', Strategy =~ 'MigrateToPaaS' and isnotnull(PaaSCheapest) and MIReadyCost == PaaSCheapest, 'Azure SQL MI', Strategy =~ 'MigrateToPaaS' and isnotnull(PaaSCheapest), 'Azure SQL DB', '')\n| extend SelectedTotal = case(PreferredTarget == 'SQL Server on Azure VM', VMReadyCost, PreferredTarget == 'Azure SQL MI', MIReadyCost, PreferredTarget == 'Azure SQL DB', DBReadyCost, real(null)), BaselineReady = max_of(MIReadyCost, DBReadyCost, VMReadyCost)\n| extend ComparisonStatus = case(Currency == 'Unknown', 'Unknown currency', isnull(tobool(asmt.enabled)), 'Assessment state unknown', tobool(asmt.enabled) != true, 'Assessment disabled', Strategy !in~ ('MigrateToIaaS','MigrateToPaaS'), 'Unrecognized strategy', isnull(SelectedTotal), 'No Ready priced target for strategy', 'Comparable')\n| extend MonthlyDifference = iff(ComparisonStatus == 'Comparable', BaselineReady - SelectedTotal, real(null))\n| summarize Instances = count(), Comparable = countif(ComparisonStatus == 'Comparable'), MonthlyDifference = sum(MonthlyDifference) by Currency\n| extend Excluded = Instances - Comparable, MonthlyDifference = iff(Comparable > 0, MonthlyDifference, real(null))\n| extend AnnualDifference = MonthlyDifference * 12, ThreeYearDifference = MonthlyDifference * 36\n| project Currency, Instances, Comparable, Excluded, MonthlyDifference, AnnualDifference, ThreeYearDifference\n| order by Currency asc",
              "size": 4,
              "title": "Azure target cost difference by currency (not on-premises TCO or realized savings)",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscriptions}"
              ],
              "visualization": "table",
              "showExportToExcel": true,
              "gridSettings": { "filter": true }
            },
            "customWidth": "100",
            "name": "tco-kpi"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ 'microsoft.azurearcdata/sqlserverinstances'\n| where 'value::all' in ({ResourceGroup}) or '*' in ({ResourceGroup}) or resourceGroup in~ ({ResourceGroup})\n| where '{TagName}' == '' or tostring(tags['{TagName}']) =~ '{TagValue}'\n| extend asmt = properties.migration.assessment\n| extend r = asmt.skuRecommendationResults, Strategy = tostring(asmt.settings.strategy), Currency = coalesce(tostring(asmt.settings.currency), 'Unknown')\n| where 'value::all' in ({CurrencyFilter}) or '*' in ({CurrencyFilter}) or Currency in ({CurrencyFilter})\n| extend MICost = todouble(r.azureSqlManagedInstance.monthlyCost.totalCost), DBCost = todouble(r.azureSqlDatabase.monthlyCost.totalCost), VMCost = todouble(r.azureSqlVirtualMachine.monthlyCost.totalCost)\n| extend MIReadyCost = iff(tobool(asmt.enabled) == true and tostring(r.azureSqlManagedInstance.recommendationStatus) =~ 'Ready' and MICost >= 0, MICost, real(null)), DBReadyCost = iff(tobool(asmt.enabled) == true and tostring(r.azureSqlDatabase.recommendationStatus) =~ 'Ready' and DBCost >= 0, DBCost, real(null)), VMReadyCost = iff(tobool(asmt.enabled) == true and tostring(r.azureSqlVirtualMachine.recommendationStatus) =~ 'Ready' and VMCost >= 0, VMCost, real(null))\n| extend PaaSCheapest = min_of(MIReadyCost, DBReadyCost)\n| extend PreferredTarget = case(Strategy =~ 'MigrateToIaaS' and isnotnull(VMReadyCost), 'SQL Server on Azure VM', Strategy =~ 'MigrateToPaaS' and isnotnull(PaaSCheapest) and MIReadyCost == PaaSCheapest, 'Azure SQL MI', Strategy =~ 'MigrateToPaaS' and isnotnull(PaaSCheapest), 'Azure SQL DB', '')\n| extend SelectedTotal = case(PreferredTarget == 'SQL Server on Azure VM', VMReadyCost, PreferredTarget == 'Azure SQL MI', MIReadyCost, PreferredTarget == 'Azure SQL DB', DBReadyCost, real(null)), BaselineReady = max_of(MIReadyCost, DBReadyCost, VMReadyCost)\n| extend ComparisonStatus = case(Currency == 'Unknown', 'Unknown currency', isnull(tobool(asmt.enabled)), 'Assessment state unknown', tobool(asmt.enabled) != true, 'Assessment disabled', Strategy !in~ ('MigrateToIaaS','MigrateToPaaS'), 'Unrecognized strategy', isnull(SelectedTotal), 'No Ready priced target for strategy', 'Comparable')\n| extend MonthlyDifference = iff(ComparisonStatus == 'Comparable', BaselineReady - SelectedTotal, real(null))\n| project SQLArcResourceName = name, Strategy, PreferredTarget, ComparisonStatus, SelectedTotal, BaselineReady, MonthlyDifference, AnnualDifference = MonthlyDifference * 12, ThreeYearDifference = MonthlyDifference * 36, AHBSavings = 'Unavailable: matched license baseline required', AHBEntitlement = 'Not verified', Currency, ResourceId = id, ResourceGroup = resourceGroup, SubscriptionId = subscriptionId\n| order by Currency asc, MonthlyDifference desc",
              "size": 0,
              "showAnalytics": true,
              "showExportToExcel": true,
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscriptions}"
              ],
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "ComparisonStatus",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        {
                          "operator": "==",
                          "thresholdValue": "Comparable",
                          "representation": "green",
                          "text": "{0}"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "No Ready priced target for strategy",
                          "representation": "red",
                          "text": "{0}"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "gray",
                          "text": "{0}"
                        }
                      ]
                    }
                  },
                  {
                    "columnMatch": "AHBEntitlement",
                    "formatter": 1
                  },
                  {
                    "columnMatch": "SelectedTotal",
                    "formatter": 0,
                    "numberFormat": {
                      "unit": 0,
                      "emptyValCustomText": "Unavailable",
                      "options": {
                        "style": "decimal",
                        "maximumFractionDigits": 2
                      }
                    }
                  },
                  {
                    "columnMatch": "BaselineReady",
                    "formatter": 0,
                    "numberFormat": {
                      "unit": 0,
                      "emptyValCustomText": "Unavailable",
                      "options": {
                        "style": "decimal",
                        "maximumFractionDigits": 2
                      }
                    }
                  },
                  {
                    "columnMatch": "AHBSavings",
                    "formatter": 1
                  },
                  {
                    "columnMatch": "MonthlyDifference",
                    "formatter": 8,
                    "formatOptions": {
                      "min": 0,
                      "palette": "greenRed"
                    },
                    "numberFormat": {
                      "unit": 0,
                      "emptyValCustomText": "Unavailable",
                      "options": {
                        "style": "decimal",
                        "maximumFractionDigits": 0
                      }
                    }
                  },
                  {
                    "columnMatch": "AnnualDifference",
                    "formatter": 8,
                    "formatOptions": {
                      "min": 0,
                      "palette": "greenRed"
                    },
                    "numberFormat": {
                      "unit": 0,
                      "emptyValCustomText": "Unavailable",
                      "options": {
                        "style": "decimal",
                        "maximumFractionDigits": 0
                      }
                    }
                  },
                  {
                    "columnMatch": "ThreeYearDifference",
                    "formatter": 8,
                    "formatOptions": {
                      "min": 0,
                      "palette": "greenRed"
                    },
                    "numberFormat": {
                      "unit": 0,
                      "emptyValCustomText": "Unavailable",
                      "options": {
                        "style": "decimal",
                        "maximumFractionDigits": 0
                      }
                    }
                  },
                  {
                    "columnMatch": "SubscriptionId",
                    "formatter": 5
                  },
                  {
                    "columnMatch": "ResourceGroup",
                    "formatter": 5
                  },
                  {
                    "columnMatch": "ResourceId",
                    "formatter": 7,
                    "formatOptions": {
                      "linkTarget": "Resource",
                      "linkLabel": "Open"
                    }
                  }
                ],
                "rowLimit": 1000,
                "filter": true
              },
              "sortBy": []
            },
            "name": "tco-grid"
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "tco"
      },
      "name": "group-tco"
    }
  ],
  "fallbackResourceIds": [
    "Azure Monitor"
  ],
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
}