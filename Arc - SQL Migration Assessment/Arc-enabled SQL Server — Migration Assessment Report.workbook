{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 1,
      "content": {
        "json": "## Arc-enabled SQL Server — Migration Assessment Report\n\nRead-only inventory, best practices, migration readiness, and target recommendations sourced from Azure Resource Graph (`microsoft.azurearcdata/sqlserverinstances`).\n\nUse the parameters below to scope subscriptions, resource groups, and assessment freshness threshold."
      },
      "name": "title"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "p-subs",
            "version": "KqlParameterItem/1.0",
            "name": "Subscriptions",
            "type": 6,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "typeSettings": {
              "additionalResourceOptions": [],
              "includeAll": false
            },
            "value": [
              "/subscriptions/305f553d-016a-4e67-8701-47488e7b1437"
            ]
          },
          {
            "id": "p-rg",
            "version": "KqlParameterItem/1.0",
            "name": "ResourceGroup",
            "label": "Resource group",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*",
              "showDefault": false
            },
            "query": "resources\n| where type =~ 'microsoft.azurearcdata/sqlserverinstances' or (type =~ 'microsoft.hybridcompute/machines' and (tostring(properties.detectedProperties.mssqldiscovered) =~ 'true' or tostring(properties.mssqldiscovered) =~ 'true'))\n| distinct resourceGroup\n| project value = resourceGroup, label = resourceGroup\n| order by label asc",
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources",
            "crossComponentResources": [
              "{Subscriptions}"
            ],
            "value": [
              "value::all"
            ]
          },
          {
            "id": "p-fresh",
            "version": "KqlParameterItem/1.0",
            "name": "FreshnessThresholdDays",
            "label": "Freshness threshold (days)",
            "type": 1,
            "isRequired": true,
            "typeSettings": {
              "paramValidationRules": [
                { "match": true, "regExp": "^[1-9][0-9]{0,3}$", "message": "Enter a whole number from 1 to 9999." }
              ]
            },
            "value": "30"
          },
          {
            "id": "p-currency",
            "version": "KqlParameterItem/1.0",
            "name": "CurrencyFilter",
            "label": "Currency",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*",
              "showDefault": false
            },
            "query": "resources\n| where type =~ 'microsoft.azurearcdata/sqlserverinstances'\n| extend c = coalesce(tostring(properties.migration.assessment.settings.currency), 'Unknown')\n| distinct c\n| project value = c, label = c\n| order by label asc",
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources",
            "crossComponentResources": [
              "{Subscriptions}"
            ],
            "value": [
              "value::all"
            ]
          },
          {
            "id": "p-tagname",
            "version": "KqlParameterItem/1.0",
            "name": "TagName",
            "label": "Tag name (optional)",
            "type": 1,
            "typeSettings": {
              "paramValidationRules": [
                { "match": true, "regExp": "^[^'\\\\\u0000-\u001f]*$", "message": "Apostrophes, backslashes, and control characters are not supported in this filter." }
              ]
            },
            "value": ""
          },
          {
            "id": "p-tagvalue",
            "version": "KqlParameterItem/1.0",
            "name": "TagValue",
            "label": "Tag value (optional)",
            "type": 1,
            "typeSettings": {
              "paramValidationRules": [
                { "match": true, "regExp": "^[^'\\\\\u0000-\u001f]*$", "message": "Apostrophes, backslashes, and control characters are not supported in this filter." }
              ]
            },
            "value": ""
          },
          {
            "id": "p-instance",
            "version": "KqlParameterItem/1.0",
            "name": "InstanceFilter",
            "label": "SQL instance (Databases)",
            "type": 2,
            "typeSettings": {
              "additionalResourceOptions": ["value::all"],
              "showDefault": false
            },
            "query": "resources\n| where type =~ 'microsoft.azurearcdata/sqlserverinstances'\n| where 'value::all' in ({ResourceGroup}) or '*' in ({ResourceGroup}) or resourceGroup in~ ({ResourceGroup})\n| where '{TagName}' == '' or tostring(tags['{TagName}']) =~ '{TagValue}'\n| project value = tolower(id), label = strcat(name, ' / ', resourceGroup, ' / ', subscriptionId)\n| order by label asc",
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources",
            "crossComponentResources": ["{Subscriptions}"],
            "value": "value::all"
          }
        ],
        "style": "pills",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources"
      },
      "name": "parameters"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "p-tab",
            "version": "KqlParameterItem/1.0",
            "name": "SelectedTab",
            "type": 10,
            "isRequired": true,
            "typeSettings": {
              "additionalResourceOptions": [],
              "showDefault": false
            },
            "jsonData": "[{\"value\":\"overview\",\"label\":\"Overview\",\"selected\":true},{\"value\":\"inventory\",\"label\":\"Inventory\"},{\"value\":\"readiness\",\"label\":\"Assessment & Arc Readiness\"},{\"value\":\"recommendations\",\"label\":\"Recommendations\"},{\"value\":\"databases\",\"label\":\"Databases\"},{\"value\":\"pricing\",\"label\":\"Pricing Options\"},{\"value\":\"tco\",\"label\":\"Cost Comparison\"}]"
          }
        ],
        "style": "above",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources"
      },
      "name": "tabs-selector"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "### Assessment & Arc Readiness\n\nOne operational view for Arc connectivity, SQL extension health, inventory reporting, migration-assessment freshness, target readiness, pricing availability, and prerequisites. SQL-detected Arc hosts without a visible SQL instance remain visible; instance-only assessment fields show Not applicable on those rows.\n\nGreen: configured and healthy. Yellow: attention or unverified evidence. Red: failed, unhealthy, or unsupported. Gray: explicitly not configured or not applicable. Inventory reporting requires a successful upload within three days; assessment freshness uses the selected threshold.\n\nARG does not expose current migration or best-practices job status. Report availability proves only that a report was uploaded. Use Next Action and resource links for configuration, execution history, and results. [Migration assessment](https://learn.microsoft.com/en-us/sql/sql-server/azure-arc/migration-assessment?view=sql-server-ver17) | [Best practices assessment](https://learn.microsoft.com/en-us/sql/sql-server/azure-arc/assess)"
            },
            "name": "ready-title"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ 'microsoft.azurearcdata/sqlserverinstances'\n| project ResourceId = id, SQLInstanceName = coalesce(tostring(properties.instanceName), name), InstanceResourceGroup = resourceGroup, InstanceSubscription = subscriptionId, InstanceTags = tags, HostMachineId = tolower(tostring(properties.containerResourceId)), InventoryRaw = tostring(properties.lastInventoryUploadTime), CurrentVersion = tostring(properties.currentVersion), MigrationEnabled = tobool(properties.migration.assessment.enabled), AssessmentRaw = tostring(properties.migration.assessment.assessmentUploadTime), BPAEnabled = tobool(properties.bestPracticesAssessment.enabled), Recommendations = properties.migration.assessment.skuRecommendationResults\n| join kind=fullouter (\n    resources\n    | where type =~ 'microsoft.hybridcompute/machines' or (type =~ 'microsoft.hybridcompute/machines/extensions' and tostring(properties.publisher) =~ 'Microsoft.AzureData' and tostring(properties.type) in~ ('WindowsAgent.SqlServer','LinuxAgent.SqlServer'))\n    | extend IsHost = type =~ 'microsoft.hybridcompute/machines'\n    | extend HostMachineId = iff(IsHost, tolower(id), tolower(substring(id, 0, indexof(tolower(id), '/extensions/'))))\n    | summarize ExtensionCount = countif(not(IsHost)), HostRows = make_list(iff(IsHost, pack('ResourceId', id, 'Name', name, 'ResourceGroup', resourceGroup, 'Subscription', subscriptionId, 'Tags', tags, 'OS', tostring(properties.osName), 'Status', tostring(properties.status), 'SQLDetected', tostring(properties.detectedProperties.mssqldiscovered) =~ 'true' or tostring(properties.mssqldiscovered) =~ 'true'), dynamic(null))), ExtensionRows = make_list(iff(not(IsHost), pack('State', tostring(properties.provisioningState), 'Message', tostring(properties.instanceView.status.message)), dynamic(null))) by HostMachineId\n    | project HostMachineId, HostResourceId = tostring(HostRows[0].ResourceId), HostName = tostring(HostRows[0].Name), HostResourceGroup = tostring(HostRows[0].ResourceGroup), HostSubscription = tostring(HostRows[0].Subscription), HostTags = HostRows[0].Tags, HostOS = tostring(HostRows[0].OS), AgentStatus = tostring(HostRows[0].Status), SQLDetected = tobool(HostRows[0].SQLDetected), ExtensionCount, ExtensionState = tostring(ExtensionRows[0].State), ExtensionMessage = tostring(ExtensionRows[0].Message)\n) on HostMachineId\n| where isnotempty(ResourceId) or SQLDetected == true\n| extend HasInstance = isnotempty(ResourceId), HostMachineId = coalesce(HostMachineId, HostMachineId1), ResourceGroup = coalesce(InstanceResourceGroup, HostResourceGroup), SubscriptionId = coalesce(InstanceSubscription, HostSubscription), ScopeTags = iff(isnotempty(ResourceId), InstanceTags, HostTags)\n| where 'value::all' in ({ResourceGroup}) or '*' in ({ResourceGroup}) or ResourceGroup in~ ({ResourceGroup})\n| where '{TagName}' == '' or tostring(ScopeTags['{TagName}']) =~ '{TagValue}'\n| extend InventoryTime = todatetime(InventoryRaw), AssessmentTime = todatetime(AssessmentRaw), Threshold = toint('{FreshnessThresholdDays}'), SQLMajorVersion = toint(split(CurrentVersion, '.')[0]), UploadStatus = extract(@'uploadStatus\\s*:\\s*([^;\\s]+)', 1, ExtensionMessage), AgentHealth = extract(@'SQL Server Extension Agent:\\s*([^;\\r\\n]+)', 1, ExtensionMessage), ExtensionDate = extract(@'timestampUTC\\s*:\\s*([0-9]{4}[-/][0-9]{2}[-/][0-9]{2})', 1, ExtensionMessage)\n| extend ExtensionTime = todatetime(replace_string(ExtensionDate, '/', '-')), AgeDays = datetime_diff('day', now(), AssessmentTime)\n| extend ArcConnected = case(AgentStatus =~ 'Connected', 'Yes', AgentStatus in~ ('Disconnected','Expired'), 'No', 'Unknown'), ExtensionInstalled = iff(ExtensionCount > 0, 'Yes', 'Unknown'), InventoryEvidence = case(isempty(InventoryRaw), 'No inventory evidence', isnull(InventoryTime) or InventoryTime > now(), 'Invalid timestamp', InventoryTime < ago(3d), 'Stale', 'Recent successful upload'), MigrationAssessmentEnabled = case(not(HasInstance), 'Not applicable', MigrationEnabled == true, 'Yes', MigrationEnabled == false, 'No', 'Unknown'), BestPracticesAssessmentEnabled = case(not(HasInstance), 'Not applicable', BPAEnabled == true, 'Yes', BPAEnabled == false, 'No', 'Unknown')\n| extend ExtensionStatus = case(isnull(ExtensionCount) or ExtensionCount == 0, 'Unknown', ExtensionCount != 1, 'Attention: multiple extensions', ExtensionState =~ 'Failed', 'Failed', ExtensionState in~ ('Creating','Updating','Transitioning'), 'Running', ExtensionState =~ 'Deleted', 'Not Installed', isnotempty(AgentHealth) and AgentHealth !startswith 'Healthy', 'Unhealthy', ExtensionState =~ 'Succeeded' and AgentHealth startswith 'Healthy' and UploadStatus =~ 'OK' and ExtensionTime >= ago(3d) and ExtensionTime <= now() and ArcConnected == 'Yes', 'Healthy', 'Attention')\n| extend Reporting = case(ExtensionCount == 1 and isnotempty(UploadStatus) and UploadStatus !~ 'OK', 'Failed', ArcConnected == 'No', 'Unhealthy', InventoryEvidence != 'Recent successful upload', InventoryEvidence, ExtensionStatus in ('Failed','Unhealthy','Not Installed'), 'Unhealthy', ArcConnected != 'Yes' or ExtensionInstalled != 'Yes' or ExtensionCount != 1, 'Unknown', 'Reporting')\n| extend AssessmentFreshness = case(not(HasInstance), 'Not applicable', isnull(Threshold) or Threshold < 1 or Threshold > 9999, 'Invalid threshold', isempty(AssessmentRaw), 'No data', isnull(AssessmentTime), 'Invalid timestamp', AssessmentTime > now(), 'Future timestamp', AgeDays > Threshold, 'Stale', AgeDays <= 7, 'Fresh', 'Recent'), MI = iff(HasInstance, coalesce(tostring(Recommendations.azureSqlManagedInstance.recommendationStatus), 'Unknown'), 'Not applicable'), DB = iff(HasInstance, coalesce(tostring(Recommendations.azureSqlDatabase.recommendationStatus), 'Unknown'), 'Not applicable'), VM = iff(HasInstance, coalesce(tostring(Recommendations.azureSqlVirtualMachine.recommendationStatus), 'Unknown'), 'Not applicable')\n| extend PricingStatus = case(not(HasInstance), 'Not applicable', isnull(Recommendations), 'No results', (MI =~ 'Ready' and (isnull(todouble(Recommendations.azureSqlManagedInstance.monthlyCost.totalCost)) or todouble(Recommendations.azureSqlManagedInstance.monthlyCost.totalCost) < 0)) or (DB =~ 'Ready' and (isnull(todouble(Recommendations.azureSqlDatabase.monthlyCost.totalCost)) or todouble(Recommendations.azureSqlDatabase.monthlyCost.totalCost) < 0)) or (VM =~ 'Ready' and (isnull(todouble(Recommendations.azureSqlVirtualMachine.monthlyCost.totalCost)) or todouble(Recommendations.azureSqlVirtualMachine.monthlyCost.totalCost) < 0)), 'Ready target price unavailable', MI !~ 'Ready' and DB !~ 'Ready' and VM !~ 'Ready', 'No Ready target', 'Ready target prices available'), PrerequisiteStatus = case(not(HasInstance), 'Not applicable until instance is visible', HostOS =~ 'linux', 'Unsupported: Linux assessment', isnotnull(SQLMajorVersion) and SQLMajorVersion < 12, 'Unsupported: SQL Server before 2014', isnull(SQLMajorVersion), 'SQL build not reported; other prerequisites not verified', 'Other prerequisites not verified')\n| extend OverallReadiness = case(not(HasInstance), 'Instance discovery or visibility required', PrerequisiteStatus startswith 'Unsupported', PrerequisiteStatus, ArcConnected == 'No', 'Arc disconnected', ArcConnected == 'Unknown', 'Arc status unknown', ExtensionStatus in ('Failed','Unhealthy'), ExtensionStatus, ExtensionStatus != 'Healthy', ExtensionStatus, Reporting != 'Reporting', strcat('Inventory: ', Reporting), MigrationAssessmentEnabled == 'No', 'Migration assessment disabled', MigrationAssessmentEnabled == 'Unknown', 'Migration assessment state unknown', AssessmentFreshness !in ('Fresh','Recent'), strcat('Assessment: ', AssessmentFreshness), PricingStatus != 'Ready target prices available', PricingStatus, 'Ready and current')\n| extend ReadinessSeverity = case(not(HasInstance), 1, PrerequisiteStatus startswith 'Unsupported', 2, ArcConnected == 'No', 3, ArcConnected == 'Unknown', 4, ExtensionStatus in ('Failed','Unhealthy'), 5, ExtensionStatus != 'Healthy', 6, Reporting != 'Reporting', 7, MigrationAssessmentEnabled == 'No', 8, MigrationAssessmentEnabled == 'Unknown', 9, AssessmentFreshness !in ('Fresh','Recent'), 10, PricingStatus != 'Ready target prices available', 11, 12)\n| extend ActionRequired = strcat(iff(not(HasInstance), 'Verify SQL discovery and instance read permissions; ', ''), iff(ArcConnected != 'Yes', 'Check Arc connectivity and host visibility; ', ''), iff(ExtensionStatus != 'Healthy', 'Verify SQL extension installation and health; ', ''), iff(Reporting != 'Reporting', 'Check inventory uploads and telemetry; ', ''), iff(PrerequisiteStatus startswith 'Unsupported', strcat(PrerequisiteStatus, '; '), ''), iff(HasInstance and MigrationAssessmentEnabled != 'Yes', 'Enable or verify migration assessment; ', ''), iff(HasInstance and AssessmentFreshness !in ('Fresh','Recent'), 'Run or verify migration assessment results; ', ''), iff(HasInstance and PricingStatus != 'Ready target prices available', 'Review readiness and pricing results; ', ''), iff(HasInstance and BestPracticesAssessmentEnabled != 'Yes', 'Enable or verify best practices assessment; ', ''))\n| extend NextAction = case(not(HasInstance), 'https://learn.microsoft.com/en-us/sql/sql-server/azure-arc/connect', PrerequisiteStatus startswith 'Unsupported', 'https://learn.microsoft.com/en-us/sql/sql-server/azure-arc/migration-assessment?view=sql-server-ver17', ArcConnected != 'Yes' or ExtensionStatus != 'Healthy', 'https://learn.microsoft.com/en-us/sql/sql-server/azure-arc/troubleshoot-extension', Reporting != 'Reporting', 'https://learn.microsoft.com/en-us/sql/sql-server/azure-arc/troubleshoot-extension', MigrationAssessmentEnabled != 'Yes' or AssessmentFreshness !in ('Fresh','Recent') or PricingStatus != 'Ready target prices available', 'https://learn.microsoft.com/en-us/sql/sql-server/azure-arc/migration-assessment?view=sql-server-ver17', BestPracticesAssessmentEnabled != 'Yes', 'https://learn.microsoft.com/en-us/sql/sql-server/azure-arc/assess', ''), ResultsResource = iff(isnotnull(AssessmentTime) and AssessmentTime <= now() and HasInstance, ResourceId, '')\n| extend ServerName = coalesce(HostName, tostring(split(HostMachineId, '/')[8]), 'Unknown')\n| order by ReadinessSeverity asc, ServerName asc, SQLInstanceName asc\n| project ['Server Name'] = ServerName, ['SQL Instance Name'] = iff(HasInstance, SQLInstanceName, 'Not discovered / not visible'), ['Overall Readiness'] = OverallReadiness, ['Action Required'] = ActionRequired, ['Azure Arc Connected'] = ArcConnected, ['SQL Server Extension Status'] = ExtensionStatus, ['Inventory Reporting'] = Reporting, ['Last Successful Inventory Upload'] = InventoryTime, ['Migration Assessment Enabled'] = MigrationAssessmentEnabled, ['Assessment Freshness'] = AssessmentFreshness, ['Last Migration Report Upload'] = AssessmentTime, ['MI Readiness'] = MI, ['DB Readiness'] = DB, ['VM Readiness'] = VM, ['Pricing Status'] = PricingStatus, ['Prerequisite Status'] = PrerequisiteStatus, ['Host OS'] = HostOS, ['Best Practices Assessment Enabled'] = BestPracticesAssessmentEnabled, ['Next Action'] = NextAction, ['Migration Assessment Results'] = ResultsResource, ['SQL Resource'] = ResourceId, ['Host Resource'] = HostResourceId, ResourceGroup, SubscriptionId",
              "size": 0,
              "title": "Assessment and Arc readiness by SQL instance or detected host",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": ["{Subscriptions}"],
              "visualization": "table",
              "showAnalytics": true,
              "showExportToExcel": true,
              "gridSettings": {
                "filter": true,
                "rowLimit": 1000,
                "formatters": [
                  { "columnMatch": "Overall Readiness", "formatter": 18, "formatOptions": { "thresholdsOptions": "colors", "thresholdsGrid": [
                    { "operator": "==", "thresholdValue": "Ready and current", "representation": "green", "text": "{0}" },
                    { "operator": "==", "thresholdValue": "Arc disconnected", "representation": "red", "text": "{0}" },
                    { "operator": "==", "thresholdValue": "Unsupported: Linux host", "representation": "red", "text": "{0}" },
                    { "operator": "==", "thresholdValue": "Unsupported: SQL Server before 2014", "representation": "red", "text": "{0}" },
                    { "operator": "==", "thresholdValue": "Failed", "representation": "red", "text": "{0}" },
                    { "operator": "==", "thresholdValue": "Unhealthy", "representation": "red", "text": "{0}" },
                    { "operator": "Default", "thresholdValue": null, "representation": "yellow", "text": "{0}" }
                  ] } },
                  { "columnMatch": "Azure Arc Connected", "formatter": 18, "formatOptions": { "thresholdsOptions": "colors", "thresholdsGrid": [
                    { "operator": "==", "thresholdValue": "Yes", "representation": "green", "text": "{0}" },
                    { "operator": "==", "thresholdValue": "No", "representation": "red", "text": "{0}" },
                    { "operator": "Default", "thresholdValue": null, "representation": "yellow", "text": "{0}" }
                  ] } },
                  { "columnMatch": "SQL Server Extension Status", "formatter": 18, "formatOptions": { "thresholdsOptions": "colors", "thresholdsGrid": [
                    { "operator": "==", "thresholdValue": "Healthy", "representation": "green", "text": "{0}" },
                    { "operator": "==", "thresholdValue": "Failed", "representation": "red", "text": "{0}" },
                    { "operator": "==", "thresholdValue": "Unhealthy", "representation": "red", "text": "{0}" },
                    { "operator": "==", "thresholdValue": "Not Installed", "representation": "gray", "text": "{0}" },
                    { "operator": "Default", "thresholdValue": null, "representation": "yellow", "text": "{0}" }
                  ] } },
                  { "columnMatch": "Inventory Reporting", "formatter": 18, "formatOptions": { "thresholdsOptions": "colors", "thresholdsGrid": [
                    { "operator": "==", "thresholdValue": "Reporting", "representation": "green", "text": "{0}" },
                    { "operator": "==", "thresholdValue": "Failed", "representation": "red", "text": "{0}" },
                    { "operator": "==", "thresholdValue": "Unhealthy", "representation": "red", "text": "{0}" },
                    { "operator": "Default", "thresholdValue": null, "representation": "yellow", "text": "{0}" }
                  ] } },
                  { "columnMatch": "Migration Assessment Enabled", "formatter": 18, "formatOptions": { "thresholdsOptions": "colors", "thresholdsGrid": [
                    { "operator": "==", "thresholdValue": "Yes", "representation": "green", "text": "{0}" },
                    { "operator": "==", "thresholdValue": "No", "representation": "gray", "text": "{0}" },
                    { "operator": "==", "thresholdValue": "Not applicable", "representation": "gray", "text": "{0}" },
                    { "operator": "Default", "thresholdValue": null, "representation": "yellow", "text": "{0}" }
                  ] } },
                  { "columnMatch": "Assessment Freshness", "formatter": 18, "formatOptions": { "thresholdsOptions": "colors", "thresholdsGrid": [
                    { "operator": "==", "thresholdValue": "Fresh", "representation": "green", "text": "{0}" },
                    { "operator": "==", "thresholdValue": "Recent", "representation": "green", "text": "{0}" },
                    { "operator": "==", "thresholdValue": "Stale", "representation": "red", "text": "{0}" },
                    { "operator": "==", "thresholdValue": "Not applicable", "representation": "gray", "text": "{0}" },
                    { "operator": "Default", "thresholdValue": null, "representation": "yellow", "text": "{0}" }
                  ] } },
                  { "columnMatch": "MI Readiness", "formatter": 18, "formatOptions": { "thresholdsOptions": "colors", "thresholdsGrid": [
                    { "operator": "==", "thresholdValue": "Ready", "representation": "green", "text": "{0}" },
                    { "operator": "==", "thresholdValue": "NotReady", "representation": "red", "text": "{0}" },
                    { "operator": "==", "thresholdValue": "Not applicable", "representation": "gray", "text": "{0}" },
                    { "operator": "Default", "thresholdValue": null, "representation": "yellow", "text": "{0}" }
                  ] } },
                  { "columnMatch": "DB Readiness", "formatter": 18, "formatOptions": { "thresholdsOptions": "colors", "thresholdsGrid": [
                    { "operator": "==", "thresholdValue": "Ready", "representation": "green", "text": "{0}" },
                    { "operator": "==", "thresholdValue": "NotReady", "representation": "red", "text": "{0}" },
                    { "operator": "==", "thresholdValue": "Not applicable", "representation": "gray", "text": "{0}" },
                    { "operator": "Default", "thresholdValue": null, "representation": "yellow", "text": "{0}" }
                  ] } },
                  { "columnMatch": "VM Readiness", "formatter": 18, "formatOptions": { "thresholdsOptions": "colors", "thresholdsGrid": [
                    { "operator": "==", "thresholdValue": "Ready", "representation": "green", "text": "{0}" },
                    { "operator": "==", "thresholdValue": "NotReady", "representation": "red", "text": "{0}" },
                    { "operator": "==", "thresholdValue": "Not applicable", "representation": "gray", "text": "{0}" },
                    { "operator": "Default", "thresholdValue": null, "representation": "yellow", "text": "{0}" }
                  ] } },
                  { "columnMatch": "Pricing Status", "formatter": 18, "formatOptions": { "thresholdsOptions": "colors", "thresholdsGrid": [
                    { "operator": "==", "thresholdValue": "Ready target prices available", "representation": "green", "text": "{0}" },
                    { "operator": "==", "thresholdValue": "Not applicable", "representation": "gray", "text": "{0}" },
                    { "operator": "Default", "thresholdValue": null, "representation": "yellow", "text": "{0}" }
                  ] } },
                  { "columnMatch": "Prerequisite Status", "formatter": 18, "formatOptions": { "thresholdsOptions": "colors", "thresholdsGrid": [
                    { "operator": "==", "thresholdValue": "Unsupported: Linux host", "representation": "red", "text": "{0}" },
                    { "operator": "==", "thresholdValue": "Unsupported: SQL Server before 2014", "representation": "red", "text": "{0}" },
                    { "operator": "==", "thresholdValue": "Not applicable", "representation": "gray", "text": "{0}" },
                    { "operator": "Default", "thresholdValue": null, "representation": "yellow", "text": "{0}" }
                  ] } },                  { "columnMatch": "Best Practices Assessment Enabled", "formatter": 18, "formatOptions": { "thresholdsOptions": "colors", "thresholdsGrid": [
                    { "operator": "==", "thresholdValue": "Yes", "representation": "green", "text": "{0}" },
                    { "operator": "==", "thresholdValue": "No", "representation": "gray", "text": "{0}" },
                    { "operator": "==", "thresholdValue": "Not applicable", "representation": "gray", "text": "{0}" },
                    { "operator": "Default", "thresholdValue": null, "representation": "yellow", "text": "{0}" }
                  ] } },
                  { "columnMatch": "Migration Assessment Results", "formatter": 7, "formatOptions": { "linkTarget": "Resource", "linkLabel": "Open SQL resource: Migration > Assessments" } },
                  { "columnMatch": "Next Action", "formatter": 7, "formatOptions": { "linkTarget": "Url", "linkLabel": "Open guidance" } },
                  { "columnMatch": "Last Successful Inventory Upload", "formatter": 6 },
                  { "columnMatch": "Last Migration Report Upload", "formatter": 6 },
                  { "columnMatch": "SQL Resource", "formatter": 7, "formatOptions": { "linkTarget": "Resource", "linkLabel": "Open SQL resource" } },
                  { "columnMatch": "Host Resource", "formatter": 7, "formatOptions": { "linkTarget": "Resource", "linkLabel": "Open Arc server" } }
                ]
              }
            },
            "name": "ready-grid"
          }
        ]
      },
      "conditionalVisibility": { "parameterName": "SelectedTab", "comparison": "isEqualTo", "value": "readiness" },
      "name": "group-readiness"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "### Overview\n\nLatest Arc inventory and assessment results reported to Azure Resource Graph. Readiness is instance-level; database compatibility findings require the Arc assessment report.\n\nCosts are retail assessment estimates, grouped by currency. Only enabled, Ready targets with non-negative prices and known currency contribute to monetary totals. Coverage differs by target; excluded counts include unavailable or ineligible data. Stale assessments remain visible and may contain outdated prices."
            },
            "name": "ov-title"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ 'microsoft.azurearcdata/sqlserverinstances'\n| where 'value::all' in ({ResourceGroup}) or '*' in ({ResourceGroup}) or resourceGroup in~ ({ResourceGroup})\n| where '{TagName}' == '' or tostring(tags['{TagName}']) =~ '{TagValue}'\n| extend asmt = properties.migration.assessment\n| extend Enabled = tobool(asmt.enabled)\n| summarize Total = count(), AssessmentEnabled = countif(Enabled == true), AssessmentDisabled = countif(Enabled == false), AssessmentUnknown = countif(isnull(Enabled))\n| project Metric = pack_array('Total Arc SQL instances','Migration assessment enabled','Migration assessment disabled','Assessment state unknown'), Value = pack_array(Total, AssessmentEnabled, AssessmentDisabled, AssessmentUnknown)\n| mv-expand Metric to typeof(string), Value to typeof(long)",
              "size": 4,
              "title": "Migration assessment coverage",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscriptions}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "Metric",
                  "formatter": 1
                },
                "leftContent": {
                  "columnMatch": "Value",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "blue"
                  },
                  "numberFormat": {
                    "unit": 17,
                    "options": {
                      "style": "decimal",
                      "maximumFractionDigits": 0
                    }
                  }
                },
                "showBorder": true,
                "size": "auto"
              }
            },
            "customWidth": "50",
            "name": "ov-card-coverage"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ 'microsoft.azurearcdata/sqlserverinstances'\n| where 'value::all' in ({ResourceGroup}) or '*' in ({ResourceGroup}) or resourceGroup in~ ({ResourceGroup})\n| where '{TagName}' == '' or tostring(tags['{TagName}']) =~ '{TagValue}'\n| extend asmt = properties.migration.assessment\n| extend Threshold = toint('{FreshnessThresholdDays}'), AssessmentUploadTime = todatetime(asmt.assessmentUploadTime)\n| extend AgeDays = datetime_diff('day', now(), AssessmentUploadTime)\n| extend FreshnessBucket = case(isnull(Threshold) or Threshold < 1 or Threshold > 9999, 'Invalid threshold', isempty(tostring(asmt.assessmentUploadTime)), 'No data', isnull(AssessmentUploadTime), 'Invalid timestamp', AssessmentUploadTime > now(), 'Future timestamp', AgeDays > Threshold, 'Stale', AgeDays <= 7, 'Fresh', 'Recent')\n| summarize Value = count() by Metric = FreshnessBucket\n| order by Metric asc",
              "size": 4,
              "title": "Assessment freshness alert",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscriptions}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "Metric",
                  "formatter": 1
                },
                "leftContent": {
                  "columnMatch": "Value",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "redBright"
                  },
                  "numberFormat": {
                    "unit": 17,
                    "options": {
                      "style": "decimal",
                      "maximumFractionDigits": 0
                    }
                  }
                },
                "showBorder": true,
                "size": "auto"
              }
            },
            "customWidth": "50",
            "name": "ov-card-freshness"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ 'microsoft.azurearcdata/sqlserverinstances'\n| where 'value::all' in ({ResourceGroup}) or '*' in ({ResourceGroup}) or resourceGroup in~ ({ResourceGroup})\n| where '{TagName}' == '' or tostring(tags['{TagName}']) =~ '{TagValue}'\n| extend r = properties.migration.assessment.skuRecommendationResults\n| extend MI = coalesce(tostring(r.azureSqlManagedInstance.recommendationStatus), 'Unknown'), DB = coalesce(tostring(r.azureSqlDatabase.recommendationStatus), 'Unknown'), VM = coalesce(tostring(r.azureSqlVirtualMachine.recommendationStatus), 'Unknown')\n| summarize ReadyForMI = countif(MI =~ 'Ready'), ReadyForDB = countif(DB =~ 'Ready'), ReadyForVM = countif(VM =~ 'Ready'), NotReadyAnywhere = countif(MI =~ 'NotReady' and DB =~ 'NotReady' and VM =~ 'NotReady'), UnknownTargets = countif(MI !in~ ('Ready','NotReady') or DB !in~ ('Ready','NotReady') or VM !in~ ('Ready','NotReady'))\n| project Metric = pack_array('Ready for Azure SQL MI','Ready for Azure SQL DB','Ready for SQL on Azure VM','All three targets NotReady','At least one target unknown'), Value = pack_array(ReadyForMI, ReadyForDB, ReadyForVM, NotReadyAnywhere, UnknownTargets)\n| mv-expand Metric to typeof(string), Value to typeof(long)",
              "size": 4,
              "title": "Servers ready by recommended target (server-level readiness)",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscriptions}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "Metric",
